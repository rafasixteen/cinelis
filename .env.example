APP_ENV=development
COMPOSE_PROJECT_NAME=cinelis_dev

FRONTOFFICE_COOKIE_VALIDATION_KEY=...
BACKOFFICE_COOKIE_VALIDATION_KEY=...

CADDY_DOMAIN=cinelis.localhost
CADDY_HTTP_PORT=80
CADDY_API_UPSTREAM=api:9000
CADDY_BACKOFFICE_UPSTREAM=backoffice:9000
CADDY_FRONTOFFICE_UPSTREAM=frontoffice:9000

# Host-side Yii console and CLI access. These connect through the fixed local
# PostgreSQL mapping exposed by the development Compose override.
DB_HOST=localhost
DB_PORT=5432

# Container-to-container access. PHP services use the PostgreSQL service name
# and port on the internal Docker network instead of the host mapping.
DB_CONTAINER_HOST=postgres
DB_CONTAINER_PORT=5432

DB_NAME=cinelis
DB_USER=postgres
DB_PASSWORD=postgres
