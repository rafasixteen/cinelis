# Copy this file to .env and keep the copy uncommitted.
#
# The same .env file is used by both Compose stacks:
#   Development: docker compose --env-file .env -f infra/dev/compose.yml ...
#   Production:  docker compose --env-file .env -f infra/prod/compose.yml ...
#
# The development values below are safe local defaults. Before production,
# change CADDY_DOMAIN, DB_USER, DB_PASSWORD, and both cookie keys as described
# in the comments. Compose project names and application environments are set
# directly in the environment-specific Compose files.

# Public hostname without a protocol. The development Compose context exposes
# CADDY_DOMAIN as http://<hostname>; production exposes it as
# https://<hostname>. For example: app.example.com.
CADDY_DOMAIN=cinelis.localhost

# Development-only host ports for Caddy. Production always publishes
# standard ports 80/443.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Internal PHP-FPM service addresses. Keep these names unless the service names
# in the corresponding Compose file are changed.
CADDY_API_UPSTREAM=api:9000
CADDY_BACKOFFICE_UPSTREAM=backoffice:9000
CADDY_FRONTOFFICE_UPSTREAM=frontoffice:9000

# Production image names. The deploy script builds these images locally before
# starting the production stack. Change them only when using a different image
# registry or tag.
API_IMAGE=cinelis-api-php-fpm:prod
BACKOFFICE_IMAGE=cinelis-backoffice-php-fpm:prod
FRONTOFFICE_IMAGE=cinelis-frontoffice-php-fpm:prod
CONSOLE_IMAGE=cinelis-console-php:prod
CADDY_IMAGE=cinelis-caddy:prod

# PostgreSQL connection settings. DB_CONTAINER_PORT is internal to Compose;
# development additionally publishes it on 127.0.0.1:5432. Use a non-default
# DB_USER and a long random DB_PASSWORD in production.
DB_CONTAINER_PORT=5432
DB_NAME=cinelis
DB_USER=postgres
DB_PASSWORD=postgres

# Cookie signing keys. These placeholders are acceptable only for local
# development. Generate separate long random values for production, for example:
# openssl rand -hex 32
FRONTOFFICE_COOKIE_VALIDATION_KEY=dev-frontoffice-cookie-key
BACKOFFICE_COOKIE_VALIDATION_KEY=dev-backoffice-cookie-key

# TMDB API credential used by the application. Leave the placeholder for local
# work if TMDB integration is not being used; set the real token as needed.
TMDB_BEARER_TOKEN=...

# Optional deployment setting. Uncomment and set this only if desired.
# CINELIS_BACKUP_DIR=/var/backups/cinelis
