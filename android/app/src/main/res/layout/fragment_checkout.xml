<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="24dp" android:paddingBottom="24dp">
        <TextView style="@style/TextAppearance.CineLis.PageTitle" android:text="@string/checkout_title" />
        <TextView style="@style/TextAppearance.CineLis.BodyMuted" android:layout_marginTop="10dp" android:text="@string/payment_step" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="216dp" android:layout_marginTop="28dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/checkout_movie" style="@style/Widget.CineLis.Section" />
            <TextView android:id="@+id/checkout_session" style="@style/TextAppearance.CineLis.BodyMuted" android:layout_marginTop="20dp" />
            <TextView android:id="@+id/checkout_seats" style="@style/TextAppearance.CineLis.BodyMuted" android:layout_marginTop="4dp" />
            <TextView android:id="@+id/checkout_quantity" style="@style/TextAppearance.CineLis.BodyMuted" android:layout_marginTop="4dp" />
            <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
            <View style="@style/Widget.CineLis.Divider" android:layout_marginBottom="20dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/total_label" android:textSize="16sp" />
                <TextView android:id="@+id/checkout_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>
        <TextView style="@style/Widget.CineLis.Label" android:layout_marginTop="32dp" android:text="@string/payment_method" />
        <TextView android:id="@+id/mbway_option" style="@style/Widget.CineLis.Input" android:layout_marginTop="8dp" android:gravity="center_vertical" android:text="MB WAY" android:drawableEnd="@drawable/ic_chevron_down" />
        <TextView style="@style/Widget.CineLis.Label" android:layout_marginTop="22dp" android:text="@string/phone_number" android:labelFor="@id/phone_input" />
        <EditText android:id="@+id/phone_input" style="@style/Widget.CineLis.Input" android:layout_marginTop="8dp" android:hint="912 345 678" android:inputType="phone" android:autofillHints="phone" />
        <TextView android:id="@+id/checkout_error" style="@style/Widget.CineLis.Label" android:layout_marginTop="8dp" android:textColor="@color/danger" android:visibility="gone" />
        <TextView style="@style/TextAppearance.CineLis.BodyMuted" android:layout_marginTop="24dp" android:text="@string/payment_notice" android:textSize="@dimen/caption_size" />
        <Button android:id="@+id/pay_button" style="@style/Widget.CineLis.PrimaryButton" android:layout_marginTop="24dp" android:text="@string/pay_now" />
        <ProgressBar android:id="@+id/loading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
