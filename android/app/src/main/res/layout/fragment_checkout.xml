<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_20">
        <TextView style="@style/Widget.CineLis.Wordmark" android:text="@string/wordmark" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/step_seats" android:textColor="@color/muted_foreground" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="@string/step_payment" android:textColor="@color/primary" android:textStyle="bold" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="@string/step_ticket" android:textColor="@color/muted_foreground" />
        </LinearLayout>
        <TextView style="@style/TextAppearance.CineLis.PageTitle" android:layout_marginTop="@dimen/space_32" android:text="@string/checkout_title" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_20" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="@dimen/space_16">
            <TextView android:id="@+id/checkout_movie" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/foreground" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/checkout_session" style="@style/TextAppearance.CineLis.BodyMuted" android:layout_marginTop="@dimen/space_8" />
            <TextView android:id="@+id/checkout_seats" style="@style/TextAppearance.CineLis.BodyMuted" android:layout_marginTop="@dimen/space_4" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24" android:text="@string/payment_method" android:textColor="@color/foreground" android:textStyle="bold" />
        <RadioButton android:id="@+id/mbway_option" android:layout_width="match_parent" android:layout_height="@dimen/touch_target" android:checked="true" android:text="@string/mb_way" android:textColor="@color/foreground" />
        <EditText android:id="@+id/phone_input" android:layout_width="match_parent" android:layout_height="@dimen/touch_target" android:layout_marginTop="@dimen/space_12" android:background="@drawable/bg_input" android:hint="@string/phone_number" android:inputType="phone" android:textColor="@color/foreground" android:textColorHint="@color/muted_foreground" />
        <TextView android:id="@+id/checkout_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:textColor="@color/danger" android:visibility="gone" />
        <TextView style="@style/TextAppearance.CineLis.BodyMuted" android:layout_marginTop="@dimen/space_16" android:text="@string/payment_notice" />
        <TextView android:id="@+id/checkout_total" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24" android:gravity="end" android:textColor="@color/foreground" android:textSize="28sp" android:textStyle="bold" />
        <Button android:id="@+id/pay_button" android:layout_width="match_parent" android:layout_height="@dimen/touch_target" android:layout_marginTop="@dimen/space_16" android:background="@drawable/bg_button_primary" android:text="@string/pay_now" android:textColor="@color/primary_foreground" />
        <ProgressBar android:id="@+id/loading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="@dimen/space_16" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
