<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_20">
        <TextView style="@style/Widget.CineLis.Wordmark" android:text="@string/wordmark" />
        <TextView style="@style/TextAppearance.CineLis.PageTitle" android:layout_marginTop="@dimen/space_32" android:text="@string/account_title" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_20" android:background="@drawable/bg_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="@dimen/space_16">
            <TextView android:id="@+id/avatar" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_avatar" android:gravity="center" android:textColor="@color/primary_foreground" android:textSize="20sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_16" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/account_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/foreground" android:textSize="20sp" android:textStyle="bold"/><TextView android:id="@+id/account_email" style="@style/TextAppearance.CineLis.BodyMuted" android:layout_marginTop="@dimen/space_4"/></LinearLayout>
        </LinearLayout>
        <Button android:id="@+id/edit_profile_button" android:layout_width="match_parent" android:layout_height="@dimen/touch_target" android:layout_marginTop="@dimen/space_16" android:text="@string/edit_profile" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_32" android:text="@string/purchase_history" android:textColor="@color/foreground" android:textSize="@dimen/section_title_size" android:textStyle="bold" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/orders_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:nestedScrollingEnabled="false" />
        <Button android:id="@+id/theme_button" android:layout_width="match_parent" android:layout_height="@dimen/touch_target" android:layout_marginTop="@dimen/space_24" android:text="@string/appearance" />
        <Button android:id="@+id/server_button" android:layout_width="match_parent" android:layout_height="@dimen/touch_target" android:layout_marginTop="@dimen/space_8" android:text="@string/server_settings" />
        <Button android:id="@+id/logout_button" android:layout_width="match_parent" android:layout_height="@dimen/touch_target" android:layout_marginTop="@dimen/space_8" android:text="@string/logout" />
        <Button android:id="@+id/delete_button" android:layout_width="match_parent" android:layout_height="@dimen/touch_target" android:layout_marginTop="@dimen/space_8" android:text="@string/delete_account" android:textColor="@color/danger" />
        <ProgressBar android:id="@+id/loading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="@dimen/space_16" />
    </LinearLayout>
</ScrollView>
