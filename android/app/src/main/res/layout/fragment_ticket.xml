<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="24dp" android:paddingBottom="24dp">
        <ProgressBar android:id="@+id/loading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" />
        <LinearLayout android:id="@+id/ticket_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="178dp" android:layout_height="24dp" android:background="@drawable/bg_success_badge" android:gravity="center" android:text="@string/purchase_completed" />
            <TextView style="@style/TextAppearance.CineLis.PageTitle" android:layout_marginTop="20dp" android:text="@string/ticket_title" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="420dp" android:layout_marginTop="24dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="24dp">
                <TextView android:id="@+id/ticket_movie" style="@style/TextAppearance.CineLis.PageTitle" />
                <TextView android:id="@+id/ticket_session" style="@style/TextAppearance.CineLis.BodyMuted" android:layout_marginTop="12dp" />
                <TextView android:id="@+id/ticket_seat" android:layout_width="112dp" android:layout_height="24dp" android:layout_marginTop="20dp" android:background="@drawable/bg_badge" android:gravity="center" />
                <View style="@style/Widget.CineLis.Divider" android:layout_marginTop="20dp" />
                <ImageView android:layout_width="144dp" android:layout_height="144dp" android:layout_marginTop="24dp" android:layout_gravity="center_horizontal" android:src="@drawable/qr_demo" android:contentDescription="@string/illustrative_code" />
                <TextView android:id="@+id/ticket_code" style="@style/Widget.CineLis.Label" android:layout_marginTop="20dp" android:gravity="center" android:textSize="16sp" />
                <TextView style="@style/TextAppearance.CineLis.BodyMuted" android:layout_marginTop="16dp" android:gravity="center" android:text="@string/illustrative_code" android:textSize="@dimen/caption_size" />
            </LinearLayout>
            <Button android:id="@+id/download_button" style="@style/Widget.CineLis.SecondaryButton" android:layout_marginTop="30dp" android:text="@string/download_ticket" />
        </LinearLayout>
        <TextView android:id="@+id/ticket_error" style="@style/Widget.CineLis.Label" android:gravity="center" android:textColor="@color/danger" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
