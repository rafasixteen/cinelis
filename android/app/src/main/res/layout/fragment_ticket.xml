<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="@dimen/space_20">
        <TextView style="@style/Widget.CineLis.Wordmark" android:layout_gravity="start" android:text="@string/wordmark" />
        <ProgressBar android:id="@+id/loading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_40" />
        <LinearLayout android:id="@+id/ticket_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_32" android:text="✓" android:textColor="@color/success" android:textSize="48sp" />
            <TextView style="@style/TextAppearance.CineLis.PageTitle" android:gravity="center" android:text="@string/ticket_ready" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="@dimen/space_20">
                <TextView android:id="@+id/ticket_movie" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/foreground" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/ticket_session" style="@style/TextAppearance.CineLis.BodyMuted" android:layout_marginTop="@dimen/space_8" />
                <TextView android:id="@+id/ticket_seat" style="@style/TextAppearance.CineLis.BodyMuted" android:layout_marginTop="@dimen/space_4" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24" android:text="@string/ticket_code" android:textColor="@color/muted_foreground" />
            <TextView android:id="@+id/ticket_code" android:layout_width="match_parent" android:layout_height="120dp" android:layout_marginTop="@dimen/space_8" android:background="@drawable/bg_ticket_code" android:gravity="center" android:letterSpacing="0.12" android:textColor="@color/background" android:textSize="22sp" android:textStyle="bold" />
            <Button android:id="@+id/download_button" android:layout_width="match_parent" android:layout_height="@dimen/touch_target" android:layout_marginTop="@dimen/space_20" android:text="@string/download_ticket" />
        </LinearLayout>
        <TextView android:id="@+id/ticket_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_32" android:gravity="center" android:textColor="@color/danger" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
