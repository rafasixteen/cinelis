<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="120dp" android:layout_marginBottom="20dp" android:background="@drawable/bg_card" android:clickable="true" android:focusable="true" android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/ticket_title" style="@style/Widget.CineLis.Section" />
    <TextView android:id="@+id/ticket_meta" style="@style/TextAppearance.CineLis.BodyMuted" android:layout_marginTop="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/ticket_seat" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        <Button android:id="@+id/view_ticket" style="@style/Widget.CineLis.SecondaryButton" android:layout_width="100dp" android:layout_height="44dp" android:text="@string/view_ticket" />
    </LinearLayout>
</LinearLayout>
