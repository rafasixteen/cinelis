<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginBottom="12dp" android:background="@drawable/bg_card" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:clickable="true" android:focusable="true">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/movie_title" style="@style/Widget.CineLis.Label" android:textSize="16sp" />
        <TextView android:id="@+id/movie_meta" style="@style/TextAppearance.CineLis.BodyMuted" android:layout_marginTop="6dp" />
    </LinearLayout>
    <TextView android:id="@+id/movie_rating" android:layout_width="64dp" android:layout_height="24dp" android:gravity="center" android:background="@drawable/bg_badge" />
</LinearLayout>
