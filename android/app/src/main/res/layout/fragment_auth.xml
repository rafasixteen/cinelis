<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="@dimen/space_20">
        <TextView style="@style/Widget.CineLis.Wordmark" android:layout_gravity="start" android:text="@string/wordmark" />
        <TextView android:id="@+id/auth_heading" style="@style/TextAppearance.CineLis.PageTitle" android:layout_marginTop="@dimen/space_40" android:text="@string/auth_title" />
        <TextView style="@style/TextAppearance.CineLis.BodyMuted" android:layout_marginTop="@dimen/space_8" android:text="@string/login_description" />
        <EditText android:id="@+id/name_input" android:layout_width="match_parent" android:layout_height="@dimen/touch_target" android:layout_marginTop="@dimen/space_24" android:background="@drawable/bg_input" android:hint="@string/name" android:inputType="textPersonName" android:textColor="@color/foreground" android:textColorHint="@color/muted_foreground" android:visibility="gone" />
        <EditText android:id="@+id/email_input" android:layout_width="match_parent" android:layout_height="@dimen/touch_target" android:layout_marginTop="@dimen/space_12" android:background="@drawable/bg_input" android:hint="@string/email" android:inputType="textEmailAddress" android:textColor="@color/foreground" android:textColorHint="@color/muted_foreground" />
        <EditText android:id="@+id/password_input" android:layout_width="match_parent" android:layout_height="@dimen/touch_target" android:layout_marginTop="@dimen/space_12" android:background="@drawable/bg_input" android:hint="@string/password" android:inputType="textPassword" android:textColor="@color/foreground" android:textColorHint="@color/muted_foreground" />
        <TextView android:id="@+id/auth_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:textColor="@color/danger" android:visibility="gone" />
        <Button android:id="@+id/auth_submit" android:layout_width="match_parent" android:layout_height="@dimen/touch_target" android:layout_marginTop="@dimen/space_20" android:background="@drawable/bg_button_primary" android:text="@string/sign_in" android:textColor="@color/primary_foreground" android:textStyle="bold" />
        <Button android:id="@+id/auth_toggle" android:layout_width="match_parent" android:layout_height="@dimen/touch_target" android:layout_marginTop="@dimen/space_12" android:background="@drawable/bg_button_secondary" android:text="@string/need_account" android:textColor="@color/foreground" />
    </LinearLayout>
</ScrollView>
