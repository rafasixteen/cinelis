<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="170dp" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:clickable="true" android:focusable="true" android:orientation="vertical">
    <cinelis.ui.common.MoviePosterView android:id="@+id/movie_poster" android:layout_width="match_parent" android:layout_height="190dp" android:importantForAccessibility="no" />
    <TextView android:id="@+id/movie_title" style="@style/Widget.CineLis.Label" android:layout_marginTop="12dp" android:textSize="16sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/movie_meta" style="@style/TextAppearance.CineLis.BodyMuted" android:layout_marginTop="6dp" android:maxLines="1" />
    <Button android:id="@+id/movie_sessions" style="@style/Widget.CineLis.SecondaryButton" android:layout_height="44dp" android:layout_marginTop="12dp" android:text="@string/view_sessions" />
</LinearLayout>
