<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/movie_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="top"
        android:orientation="horizontal">

        <cinelis.ui.common.MoviePosterView
            android:id="@+id/movie_poster"
            android:layout_width="104dp"
            android:layout_height="148dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="148dp"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/movie_title"
                style="@style/Widget.CineLis.Section"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/movie_meta"
                style="@style/TextAppearance.CineLis.BodyMuted"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/movie_rating"
                android:layout_width="64dp"
                android:layout_height="24dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_badge"
                android:gravity="center" />

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                style="@style/TextAppearance.CineLis.BodyMuted"
                android:text="@string/open_movie_details"
                android:textSize="@dimen/caption_size" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/Widget.CineLis.Label"
        android:layout_marginTop="16dp"
        android:text="@string/sessions_today" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/session_times"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>
</LinearLayout>
