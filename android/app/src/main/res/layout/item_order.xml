<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="76dp" android:layout_marginBottom="16dp" android:background="@drawable/bg_card" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/order_title" style="@style/Widget.CineLis.Label" android:textSize="16sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/order_meta" style="@style/TextAppearance.CineLis.BodyMuted" android:layout_marginTop="10dp" />
    </LinearLayout>
    <TextView android:id="@+id/order_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="16sp" />
</LinearLayout>
